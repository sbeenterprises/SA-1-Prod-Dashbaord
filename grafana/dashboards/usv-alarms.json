{
  "uid": "usv-alarms",
  "title": "Alarms & Notifications",
  "tags": [
    "usv",
    "alarms"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "",
      "tags": [
        "usv"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "\u2600 Light",
      "url": "/d/usv-alarms?theme=light",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in light theme"
    },
    {
      "type": "link",
      "title": "\u263e Dark",
      "url": "/d/usv-alarms?theme=dark",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in dark theme"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vessel",
        "label": "Vessel",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "usv-01",
          "value": "usv-01"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 119,
      "type": "alertlist",
      "title": "Active Alerts",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "alertName": "",
        "dashboardAlerts": false,
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "viewMode": "list"
      }
    },
    {
      "id": 120,
      "type": "table",
      "title": "Alarm History (events bucket)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"events\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\")\n  |> filter(fn: (r) => r.type == \"alarm\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> keep(columns: [\"_time\", \"_value\", \"severity\"])\n  |> sort(columns: [\"_time\"], desc: true)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
