    {
      "id": 196,
      "type": "table",
      "title": "Alarm History (events bucket)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"events\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\")\n  |> filter(fn: (r) => r.type == \"alarm\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\", \"severity\"])\n  |> rename(columns: {_time: \"Time\", _value: \"Alarm\", severity: \"Severity\"})\n  |> sort(columns: [\"Time\"], desc: true)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 197,
      "type": "stat",
      "title": "Battery SOC",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
