{
  "uid": "usv-health",
  "title": "Vessel Health",
  "tags": [
    "usv",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "",
      "tags": [
        "usv"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "\u2600 Light",
      "url": "/d/usv-health?theme=light",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in light theme"
    },
    {
      "type": "link",
      "title": "\u263e Dark",
      "url": "/d/usv-health?theme=dark",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in dark theme"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vessel",
        "label": "Vessel",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "usv-01",
          "value": "usv-01"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 53,
      "type": "stat",
      "title": "Engine RPM",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"engine\" and (r._field == \"rpm\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "rotrpm",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4500
              },
              {
                "color": "red",
                "value": 5500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
