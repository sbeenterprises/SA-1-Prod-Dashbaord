                  "mode": "fixed",
                  "fixedColor": "#2f6fd8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurekpa"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
