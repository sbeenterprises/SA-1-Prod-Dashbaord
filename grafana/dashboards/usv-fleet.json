{
  "uid": "usv-fleet",
  "title": "Fleet Overview",
  "tags": [
    "usv",
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "",
      "tags": [
        "usv"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "\u2600 Light",
      "url": "/d/usv-fleet?theme=light",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in light theme"
    },
    {
      "type": "link",
      "title": "\u263e Dark",
      "url": "/d/usv-fleet?theme=dark",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in dark theme"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vessel",
        "label": "Vessel",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 175,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "![Swiftships](/public/img/swiftships_wordmark_chip_sm.png) &nbsp;&nbsp; **FLEET OVERVIEW** &nbsp;&nbsp;&middot;&nbsp;&nbsp; Vessel **$vessel**"
      }
    },
    {
      "id": 134,
      "type": "geomap",
      "title": "Fleet Map \u2014 last known positions",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\"))\n  |> last()\n  |> pivot(rowKey: [\"vessel\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"vessel\", \"lat\", \"lon\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 11
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OSM"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Vessels",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 9
                },
                "color": {
                  "fixed": "#00bcd4"
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "text": {
                  "field": "vessel",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 13,
                  "offsetX": 0,
                  "offsetY": -14,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              },
              "showLegend": false
            }
          }
        ],
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        }
      }
    },
    {
      "id": 135,
      "type": "row",
      "title": "Vessel: $vessel",
      "repeat": "vessel",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 136,
      "type": "stat",
      "title": "Mission State",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mission_state\" and (r._field == \"state\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> keep(columns: [\"_value\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00bcd4",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Idle": {
                  "text": "Idle",
                  "color": "#4d545c",
                  "index": 0
                },
                "Autonomous": {
                  "text": "Autonomous",
                  "color": "#175d8d",
                  "index": 1
                },
                "Paused": {
                  "text": "Paused",
                  "color": "yellow",
                  "index": 2
                },
                "StationKeeping": {
                  "text": "StationKeeping",
                  "color": "#00bcd4",
                  "index": 3
                },
                "ReturnToHome": {
                  "text": "ReturnToHome",
                  "color": "orange",
                  "index": 4
                },
                "EnteringRegion": {
                  "text": "EnteringRegion",
                  "color": "super-light-blue",
                  "index": 5
                },
                "AwaitingRearm": {
                  "text": "AwaitingRearm",
                  "color": "orange",
                  "index": 6
                },
                "CommsLost": {
                  "text": "CommsLost",
                  "color": "red",
                  "index": 7
                },
                "Parked": {
                  "text": "Parked",
                  "color": "#6e7680",
                  "index": 8
                },
                "Completed": {
                  "text": "Completed",
                  "color": "purple",
                  "index": 9
                }
              }
            }
          ],
          "links": [
            {
              "title": "Open Mission dashboard",
              "url": "/d/usv-mission?var-vessel=${vessel}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto"
      }
    },
