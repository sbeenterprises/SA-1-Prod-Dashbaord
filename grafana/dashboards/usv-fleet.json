  "templating": {
    "list": [
      {
        "name": "fleet_vessel",
        "label": "Vessels",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 208,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "![Swiftships](/public/img/swiftships_wordmark_chip_sm.png) &nbsp;&nbsp; **FLEET** &nbsp;&nbsp;&middot;&nbsp;&nbsp; Vessel **$fleet_vessel**"
      }
    },
    {
      "id": 167,
      "type": "geomap",
      "title": "Fleet Map \u2014 last known positions",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\" or r._field == \"heading\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"vessel\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> keep(columns: [\"vessel\", \"lat\", \"lon\", \"heading\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "zoom": 14
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OSM"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Vessels",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 14
                },
                "color": {
                  "fixed": "#d9342b"
                },
                "opacity": 1,
                "symbol": {
                  "fixed": "img/icons/marker/triangle.svg",
                  "mode": "fixed"
                },
                "rotation": {
                  "field": "heading",
                  "mode": "mod",
                  "min": -360,
                  "max": 360,
                  "fixed": 0
                },
                "text": {
                  "field": "vessel",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 13,
                  "offsetX": 0,
                  "offsetY": -18,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              },
              "showLegend": false
            }
          }
        ],
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        }
      }
    },
    {
      "id": 168,
      "type": "row",
      "title": "Vessel: $fleet_vessel",
      "repeat": "fleet_vessel",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 169,
      "type": "stat",
      "title": "Mission State",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mission_state\" and (r._field == \"state\"))\n  |> filter(fn: (r) => r.vessel == \"${fleet_vessel}\")\n  |> last()\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n  |> keep(columns: [\"_value\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00bcd4",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Idle": {
                  "text": "Idle",
                  "color": "#4d545c",
                  "index": 0
                },
                "Autonomous": {
                  "text": "Autonomous",
                  "color": "#175d8d",
                  "index": 1
                },
                "Remote": {
                  "text": "Remote",
                  "color": "orange",
                  "index": 2
                },
                "Paused": {
                  "text": "Paused",
                  "color": "yellow",
                  "index": 3
                },
                "StationKeeping": {
                  "text": "Station Keeping",
                  "color": "#00bcd4",
                  "index": 4
                },
                "ReturnToBase": {
                  "text": "Return to Base",
                  "color": "orange",
                  "index": 5
                },
                "ReturnToHome": {
                  "text": "Return to Base",
                  "color": "orange",
                  "index": 6
                },
                "EnteringRegion": {
                  "text": "Entering Region",
                  "color": "super-light-blue",
                  "index": 7
                },
                "AwaitingRearm": {
                  "text": "Awaiting Re-arm",
                  "color": "orange",
                  "index": 8
                },
                "CommsLost": {
                  "text": "Comms Lost",
                  "color": "red",
                  "index": 9
                },
                "Parked": {
                  "text": "Parked",
                  "color": "#6e7680",
                  "index": 10
                },
                "Completed": {
                  "text": "Completed",
                  "color": "purple",
                  "index": 11
                }
              }
            }
          ],
          "links": [
            {
              "title": "Open Mission dashboard",
              "url": "/d/usv-mission?var-vessel=${fleet_vessel}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "text": {
          "valueSize": 22,
          "titleSize": 12
        }
      }
    },
