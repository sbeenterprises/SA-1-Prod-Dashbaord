    "list": [
      {
        "name": "vessel",
        "label": "Vessel",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "usv-01",
          "value": "usv-01"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "theme",
        "label": "Theme",
        "type": "custom",
        "query": "Dark : dark,Navy : navy,Light : light",
        "current": {
          "text": "Dark",
          "value": "dark"
        },
        "options": [
          {
            "text": "Dark",
            "value": "dark",
            "selected": true
          },
          {
            "text": "Navy",
            "value": "navy",
            "selected": false
          },
          {
            "text": "Light",
            "value": "light",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "engine_type",
        "label": "Engine",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "hide": 2,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"engine_type\", predicate: (r) => r.vessel == \"${vessel}\", start: -30d)",
        "refresh": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "engine_model",
        "label": "Engine model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "hide": 2,
        "query": "import \"array\"\nnamed = from(bucket: \"telemetry\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"engine\" and r.vessel == \"${vessel}\")\n  |> filter(fn: (r) => exists r.engine_model or exists r.engine_type)\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: if exists r.engine_model then r.engine_model else r.engine_type}))\n  |> group()\nnone = array.from(rows: [{_time: 1970-01-01T00:00:00Z, _value: \"not reported\"}])\nunion(tables: [named, none])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> keep(columns: [\"_value\"])\n",
        "refresh": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "vessel_class",
        "label": "Vessel class",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "hide": 2,
        "query": "import \"array\"\nnamed = from(bucket: \"telemetry\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"vessel\" and r.vessel == \"${vessel}\")\n  |> filter(fn: (r) => r._field == \"class_name\" and exists r.vessel_class)\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r.vessel_class}))\n  |> group()\nnone = array.from(rows: [{_time: 1970-01-01T00:00:00Z, _value: \"Swiftships USV\"}])\nunion(tables: [named, none])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> keep(columns: [\"_value\"])\n",
        "refresh": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
