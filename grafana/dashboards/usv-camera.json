    {
      "id": 138,
      "type": "table",
      "title": "Cameras",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -30s)\n  |> filter(fn: (r) => r._measurement == \"camera\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> filter(fn: (r) => r._field == \"connected\" or r._field == \"stream_up\" or r._field == \"fps\" or r._field == \"recording\")\n  |> last()\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"vessel\", \"_time\"])\n  |> group()\n  |> pivot(rowKey: [\"cam\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"cam\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "no camera enabled in Frigate"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cam"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Camera"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "connected"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Network"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NO ANSWER",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "CONNECTED",
                        "color": "#175d8d",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stream_up"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stream"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NO VIDEO",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "LIVE",
                        "color": "#175d8d",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recording"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Recording"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "off",
                        "color": "#3d434b",
                        "index": 0
                      },
                      "1": {
                        "text": "RECORDING",
                        "color": "#175d8d",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fps"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Frame rate"
              },
              {
                "id": "unit",
                "value": "fps"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "cam": 0,
              "connected": 1,
              "stream_up": 2,
              "fps": 3,
              "recording": 4
            }
          }
        }
      ],
      "description": "One row per camera enabled in Frigate. A camera that is configured but disabled there (not yet powered) is not listed."
    },
    {
      "id": 143,
      "type": "timeseries",
      "title": "Frame Rate",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camera\" and (r._field == \"fps\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n",
          "refId": "A",
          "alias": "fps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "fps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": 60000,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*fps.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00bcd4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
