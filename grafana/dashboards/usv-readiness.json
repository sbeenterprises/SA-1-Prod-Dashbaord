    {
      "id": 102,
      "type": "table",
      "title": "Automatic checks \u2014 verified onboard from live telemetry",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "base = from(bucket: \"telemetry\")\n  |> range(start: -60s)\n  |> filter(fn: (r) => r._measurement == \"readiness\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"vessel\", \"_time\"])\nnums = base |> filter(fn: (r) => r._field == \"seq\" or r._field == \"status\")\n  |> group()\n  |> pivot(rowKey: [\"check\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nstrs = base |> filter(fn: (r) => r._field == \"name\" or r._field == \"evidence\")\n  |> group()\n  |> pivot(rowKey: [\"check\"], columnKey: [\"_field\"], valueColumn: \"_value\")\njoin(tables: {n: nums, s: strs}, on: [\"check\"])\n  |> sort(columns: [\"seq\"])\n  |> keep(columns: [\"seq\", \"name\", \"evidence\", \"status\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "grafana_bridge not writing readiness (bridge older than v1.1 or not restarted)"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "PASS",
                        "color": "#175d8d",
                        "index": 0
                      },
                      "1": {
                        "text": "FAIL",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "N/A",
                        "color": "#3d434b",
                        "index": 2
                      },
                      "3": {
                        "text": "CONSOLE",
                        "color": "#6e7680",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
