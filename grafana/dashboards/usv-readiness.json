    {
      "id": 94,
      "type": "stat",
      "title": "Readiness",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"readiness_summary\" and (r._field == \"ready\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "NO BRIDGE",
          "thresholds": {
            "mode": "absolute",
