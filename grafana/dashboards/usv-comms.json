    {
      "id": 101,
      "type": "stat",
      "title": "Internet",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"comms\" and (r._field == \"internet_up\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00bcd4",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "#175d8d",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
