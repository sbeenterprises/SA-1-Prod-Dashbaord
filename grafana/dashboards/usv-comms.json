    {
      "id": 147,
      "type": "timeseries",
      "title": "Latency",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
