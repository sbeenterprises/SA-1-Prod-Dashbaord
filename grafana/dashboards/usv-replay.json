    {
      "id": 167,
      "type": "text",
      "title": "How to replay",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 2
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Set the **time range** (top right) to the mission window, then scrub with the shared crosshair. Data older than the raw retention (30 d) is served from the 1-minute downsampled bucket. Use the **Mission events** annotations to locate waypoint hits and state changes."
      }
    },
    {
      "id": 168,
      "type": "geomap",
      "title": "GPS Track",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "bucket = if int(v: now()) - int(v: v.timeRangeStart) > int(v: 30d) then \"telemetry_1m\" else \"telemetry\"\nfrom(bucket: bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: 10s, fn: last, createEmpty: false)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> keep(columns: [\"_time\", \"lat\", \"lon\"])\n  |> sort(columns: [\"_time\"])\n",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\" or r._field == \"heading\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"vessel\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> keep(columns: [\"vessel\", \"lat\", \"lon\", \"heading\"])\n",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"geometry\" and r.kind == \"route\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"seq\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"idx\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> sort(columns: [\"seq\"])\n  |> map(fn: (r) => ({r with wp: string(v: int(v: r.seq) + 1)}))\n  |> keep(columns: [\"seq\", \"wp\", \"lat\", \"lon\"])\n",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"geometry\" and r.kind == \"region\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"seq\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"idx\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> sort(columns: [\"seq\"])\n  |> map(fn: (r) => ({r with wp: string(v: int(v: r.seq) + 1)}))\n  |> keep(columns: [\"seq\", \"wp\", \"lat\", \"lon\"])\n",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "zoom": 15
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OSM"
        },
        "layers": [
          {
            "type": "route",
            "name": "Operating region",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "D"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#00bcd4"
                },
                "lineWidth": 3,
                "opacity": 0.9
              }
            }
          },
          {
            "type": "route",
            "name": "Planned route",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "C"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#2e7d32"
                },
                "lineWidth": 2,
                "opacity": 0.9
              }
            }
          },
          {
            "type": "markers",
            "name": "Waypoints",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "C"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 6
                },
                "color": {
                  "fixed": "#2e7d32"
                },
                "opacity": 1,
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "text": {
                  "field": "wp",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": -12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              },
              "showLegend": false
            }
          },
          {
            "type": "route",
            "name": "Track",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#e53935"
                },
                "lineWidth": 2,
                "opacity": 0.9
              }
            }
          },
          {
            "type": "markers",
            "name": "Vessel",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 14
                },
                "color": {
                  "fixed": "#d9342b"
                },
                "opacity": 1,
                "symbol": {
                  "fixed": "img/icons/marker/triangle.svg",
                  "mode": "fixed"
                },
                "rotation": {
                  "field": "heading",
                  "mode": "mod",
                  "min": -360,
                  "max": 360,
                  "fixed": 0
                },
                "text": {
                  "field": "vessel",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 13,
                  "offsetX": 0,
                  "offsetY": -18,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              },
              "showLegend": false
            }
          }
        ]
      }
    },
    {
      "id": 169,
      "type": "state-timeline",
      "title": "Mission State",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mission_state\" and (r._field == \"state\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Idle": {
                  "text": "Idle",
                  "color": "#4d545c",
                  "index": 0
                },
                "Autonomous": {
                  "text": "Autonomous",
                  "color": "#175d8d",
                  "index": 1
                },
                "Remote": {
                  "text": "Remote",
                  "color": "orange",
                  "index": 2
                },
                "Paused": {
                  "text": "Paused",
                  "color": "yellow",
                  "index": 3
                },
                "StationKeeping": {
                  "text": "Station Keeping",
                  "color": "#00bcd4",
                  "index": 4
                },
                "ReturnToBase": {
                  "text": "Return to Base",
                  "color": "orange",
                  "index": 5
                },
                "ReturnToHome": {
                  "text": "Return to Base",
                  "color": "orange",
                  "index": 6
                },
                "EnteringRegion": {
                  "text": "Entering Region",
                  "color": "super-light-blue",
                  "index": 7
                },
                "AwaitingRearm": {
                  "text": "Awaiting Re-arm",
                  "color": "orange",
                  "index": 8
                },
                "CommsLost": {
                  "text": "Comms Lost",
                  "color": "red",
                  "index": 9
                },
                "Parked": {
                  "text": "Parked",
                  "color": "#6e7680",
                  "index": 10
                },
                "Completed": {
                  "text": "Completed",
                  "color": "purple",
                  "index": 11
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto"
      }
    },
    {
      "id": 170,
      "type": "table",
      "title": "Mission Events",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"events\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\", \"type\", \"severity\"])\n  |> rename(columns: {_time: \"Time\", _value: \"Event\", type: \"Type\", severity: \"Severity\"})\n  |> sort(columns: [\"Time\"], desc: true)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 171,
      "type": "timeseries",
      "title": "Heading History",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "bucket = if int(v: now()) - int(v: v.timeRangeStart) > int(v: 30d) then \"telemetry_1m\" else \"telemetry\"\nfrom(bucket: bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"heading\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n",
          "refId": "A",
          "alias": "heading"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "degree",
          "min": 0,
          "max": 360,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": 60000,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*heading.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00bcd4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
