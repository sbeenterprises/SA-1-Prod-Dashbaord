        }
      }
    },
    {
      "id": 173,
      "type": "timeseries",
      "title": "Actuator Commands",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "bucket = if int(v: now()) - int(v: v.timeRangeStart) > int(v: 30d) then \"telemetry_1m\" else \"telemetry\"\nfrom(bucket: bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"autopilot\" and (r._field == \"rudder_cmd\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> drop(fn: (column) => column =~ /^(_start|_stop|_measurement|vessel|host|instance|source)$/)\n",
          "refId": "A",
          "alias": "rudder \u00b0"
        },
        {
          "datasource": {
            "type": "influxdb",
