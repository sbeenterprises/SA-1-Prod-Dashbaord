{
  "uid": "usv-replay",
  "title": "Mission Replay",
  "tags": [
    "usv",
    "replay"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "",
      "tags": [
        "usv"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "\u2600 Light",
      "url": "/d/usv-replay?theme=light",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in light theme"
    },
    {
      "type": "link",
      "title": "\u263e Dark",
      "url": "/d/usv-replay?theme=dark",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "View in dark theme"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vessel",
        "label": "Vessel",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "usv-01",
          "value": "usv-01"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 122,
      "type": "text",
      "title": "How to replay",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Set the **time range** (top right) to the mission window, then scrub with the shared crosshair. Data older than the raw retention (30 d) is served from the 1-minute downsampled bucket. Use the **Mission events** annotations to locate waypoint hits and state changes."
      }
    },
    {
      "id": 123,
      "type": "geomap",
      "title": "GPS Track",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> aggregateWindow(every: 10s, fn: last, createEmpty: false)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit"
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OSM"
        },
        "layers": [
          {
            "type": "route",
            "name": "Track",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "orange"
                },
                "lineWidth": 2
              }
            }
          }
        ]
      }
    },
    {
      "id": 124,
      "type": "state-timeline",
      "title": "Mission State",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 14,
        "y": 2,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mission_state\" and (r._field == \"state\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Idle": {
                  "text": "Idle",
                  "color": "#4d545c",
                  "index": 0
                },
                "Autonomous": {
                  "text": "Autonomous",
                  "color": "green",
                  "index": 1
                },
                "Paused": {
                  "text": "Paused",
                  "color": "yellow",
                  "index": 2
                },
                "StationKeeping": {
                  "text": "StationKeeping",
                  "color": "blue",
                  "index": 3
                },
                "ReturnToHome": {
                  "text": "ReturnToHome",
                  "color": "orange",
                  "index": 4
                },
                "EnteringRegion": {
                  "text": "EnteringRegion",
                  "color": "super-light-blue",
                  "index": 5
                },
                "AwaitingRearm": {
                  "text": "AwaitingRearm",
                  "color": "orange",
                  "index": 6
                },
                "CommsLost": {
                  "text": "CommsLost",
                  "color": "red",
                  "index": 7
                },
                "Parked": {
                  "text": "Parked",
                  "color": "#6e7680",
                  "index": 8
                },
                "Completed": {
                  "text": "Completed",
                  "color": "purple",
                  "index": 9
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto"
      }
    },
    {
      "id": 125,
      "type": "table",
      "title": "Mission Events",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"events\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\")\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> keep(columns: [\"_time\", \"_value\", \"type\", \"severity\"])\n  |> sort(columns: [\"_time\"], desc: true)\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 126,
      "type": "timeseries",
      "title": "Heading History",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"heading\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n",
          "refId": "A",
          "alias": "heading"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "degree",
          "min": 0,
          "max": 360,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 60000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*heading.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0f9e92"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
