        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-usv"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"vessel\")",
        "refresh": 2,
        "current": {
          "text": "usv-01",
          "value": "usv-01"
        },
        "includeAll": false,
        "multi": false
      }
    ]
