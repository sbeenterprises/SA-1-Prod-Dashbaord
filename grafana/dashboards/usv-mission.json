    {
      "id": 1,
      "type": "stat",
      "title": "Mission State",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-usv"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mission_state\" and (r._field == \"state\"))\n  |> filter(fn: (r) => r.vessel == \"${vessel}\")\n  |> last()\n  |> keep(columns: [\"_value\"])\n",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00bcd4",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Idle": {
                  "text": "Idle",
                  "color": "#4d545c",
                  "index": 0
                },
                "Autonomous": {
                  "text": "Autonomous",
                  "color": "#175d8d",
                  "index": 1
                },
                "Paused": {
                  "text": "Paused",
                  "color": "yellow",
                  "index": 2
                },
                "StationKeeping": {
                  "text": "StationKeeping",
                  "color": "#00bcd4",
                  "index": 3
                },
                "ReturnToHome": {
                  "text": "ReturnToHome",
                  "color": "orange",
                  "index": 4
                },
                "EnteringRegion": {
                  "text": "EnteringRegion",
                  "color": "super-light-blue",
                  "index": 5
                },
                "AwaitingRearm": {
                  "text": "AwaitingRearm",
                  "color": "orange",
                  "index": 6
                },
                "CommsLost": {
                  "text": "CommsLost",
                  "color": "red",
                  "index": 7
                },
                "Parked": {
                  "text": "Parked",
                  "color": "#6e7680",
                  "index": 8
                },
                "Completed": {
                  "text": "Completed",
                  "color": "purple",
                  "index": 9
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "text": {
          "valueSize": 26,
          "titleSize": 12
        }
      }
    },
