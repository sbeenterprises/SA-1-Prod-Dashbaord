      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "![Swiftships](/public/img/swiftships_wordmark_chip_sm.png) &nbsp;&nbsp; **MISSION** &nbsp;&nbsp;&middot;&nbsp;&nbsp; Vessel **$vessel**"
      }
