    {
      "id": 14,
      "type": "table",
      "title": "Mission Event Timeline",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-usv"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
