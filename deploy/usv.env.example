# USV monitoring configuration.
# Copy to /etc/usv/usv.env, change every secret, then run deploy/install.sh.

# InfluxDB (native, localhost:8086)
INFLUX_URL=http://localhost:8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_ME_strong_password
INFLUX_ORG=usv
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=CHANGE_ME_generate_a_long_random_token
TELEMETRY_RETENTION=30d

# Grafana admin (initial password; change after first login)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password
# Grafana HTTP port. The vessel's Signal K server owns port 3000, so
# Grafana runs on 3001 by default to avoid the clash.
GRAFANA_PORT=3001
# Firewall (ufw). When ufw is active, install.sh allows GRAFANA_PORT/tcp
# from these sources only (space-separated CIDRs). Unset = auto: the LAN
# subnet of the default-route interface plus the Tailscale range
# 100.64.0.0/10. Set to "none" to leave ufw untouched.
#GRAFANA_ALLOW_FROM="192.168.6.0/24 100.64.0.0/10"

# Vessel
VESSEL_ID=usv-01

# Data sources on this machine (Signal K server web/stream port: 3000)
# subscribe=self: own ship only. The bridge also drops deltas for other
# vessels (AIS targets) if a URL with subscribe=all is configured.
SIGNALK_URL=ws://localhost:3000/signalk/v1/stream?subscribe=self
# Fleet / multi-instance simulation: one signalk_bridge per Signal K
# instance, tagged with its vessel id. Space-separated "<vessel>:<port>".
# Leave empty for a single vessel (SIGNALK_URL + VESSEL_ID above).
#VESSELS="alpha:3000 bravo:3001 charlie:3002 delta:3003 echo:3004 foxtrot:3005"
VESSELS=
CAN_INTERFACE=can0
# Battery charted on Vessel Health / Power (Signal K electrical.batteries.<id>).
# Default: the first instance Signal K reports (usv-722: House, Victron VE.Direct).
#SIGNALK_BATTERY=House

# Camera status (Cameras dashboard, Readiness "Cameras") from the Frigate NVR
# API. Only cameras ENABLED in Frigate are reported; a camera configured but
# disabled there (e.g. not yet powered) is not a fault. Empty = disabled.
FRIGATE_URL=
#FRIGATE_URL=http://127.0.0.1:5000
#FRIGATE_POLL_S=5

# Radar targets (mayara-server, e.g. Simrad Halo). Set MAYARA_URL to enable
# the usv-mayara-bridge service: mayara's tracked ARPA targets are posted to
# the MOOSDB as RADAR_TARGET and appear on the Traffic dashboard as radar
# contacts. Display only: the helm / contact manager do not use them.
# Leave empty on hosts without a radar (simulation).
MAYARA_URL=
#MAYARA_URL=http://localhost:3001
#MAYARA_RADAR=nav6959          # radar id; default: the first one mayara reports
#MAYARA_POLL_MS=1000           # poll period (200..10000)
#MAYARA_ID_PREFIX=R            # dashboard id of an automatically acquired target: R5, R6, ...
#MAYARA_MANUAL_PREFIX=M        # ... and of one acquired by hand in mayara: M10, ...
#MAYARA_INCLUDE_ACQUIRING=0    # 1 = also show targets mayara is still acquiring
#MAYARA_CPA_MIN_KN=2.0         # CPA/TCPA only for targets moving faster than this
#MAYARA_CPA_MAX_TCPA_S=1800    # ... and only when the closest approach is this near
#MOOS_HOST=localhost           # MOOSDB of the mission (community alpha: 9000)
#MOOS_PORT=9000

LOG_LEVEL=INFO

# systemd unit that runs pAntler (if any). The installer makes sure its PATH
# can reach /usr/local/bin/grafana_bridge (drop-in), e.g. moos-antler.service
MOOS_ANTLER_UNIT=

# Branding text (deploy/brand.sh): browser-tab title and login heading
BRAND_TITLE="Swiftships USV Console"
BRAND_APP_TITLE="SA-1 Dashboard"        # name shown next to the logo in the navigation menu
# GRAFANA_HOME_DASHBOARD=usv-readiness.json   # dashboard shown when Grafana opens
# GRAFANA_MIN_REFRESH=1s                    # fastest dashboard refresh allowed (Autopilot pages use 1 s)
BRAND_WELCOME="Welcome to Swiftships"
BRAND_SUBTITLE="Autonomous Dashboard"

# Alert email (Grafana SMTP). Leave SMTP_HOST empty to keep email off and
# deliver alerts through a webhook contact point only
# (grafana/provisioning/alerting/contact-points.yml holds the recipients:
# replace ops@example.com before installing on a vessel).
SMTP_HOST=                      # e.g. smtp.office365.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=sa1-dashboard@example.com
SMTP_FROM_NAME="SA-1 Dashboard"
#SMTP_STARTTLS_POLICY=MandatoryStartTLS   # OpportunisticStartTLS | MandatoryStartTLS | NoStartTLS
#SMTP_SKIP_VERIFY=false

# Analog instrument panels (Business Charts / Apache ECharts plugin).
# Pinned for reproducible vessel installs (match the validated host:
# grafana-cli plugins ls); clear it to take the latest
# signed release (development hosts only).
ECHARTS_PANEL_VERSION=7.2.5
