# USV monitoring configuration.
# Copy to /etc/usv/usv.env, change every secret, then run deploy/install.sh.

# InfluxDB (native, localhost:8086)
INFLUX_URL=http://localhost:8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_ME_strong_password
INFLUX_ORG=usv
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=CHANGE_ME_generate_a_long_random_token
TELEMETRY_RETENTION=30d

# Grafana admin (initial password; change after first login)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password
# Grafana HTTP port. The vessel's Signal K server owns port 3000, so
# Grafana runs on 3001 by default to avoid the clash.
GRAFANA_PORT=3001

# Vessel
VESSEL_ID=usv-01

# Data sources on this machine (Signal K server web/stream port: 3000)
SIGNALK_URL=ws://localhost:3000/signalk/v1/stream?subscribe=all
CAN_INTERFACE=can0

LOG_LEVEL=INFO

# Analog instrument panels (Business Charts / Apache ECharts plugin).
# Leave empty to install the latest signed release; pin for reproducible
# fleet installs, e.g. ECHARTS_PANEL_VERSION=6.6.0
ECHARTS_PANEL_VERSION=
