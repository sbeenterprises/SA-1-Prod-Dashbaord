# Grafana behind the Signal K login (SK_LOGIN=1). Written by
# deploy/install.sh from deploy/nginx/usv-dashboard.conf.in.
#   __LISTEN__          GRAFANA_PORT (where operators open the dashboard)
#   __GRAFANA__         127.0.0.1:GRAFANA_INTERNAL_PORT (Grafana itself)
#   __AUTH__            127.0.0.1:USV_AUTH_PORT (usv-auth)
map $http_upgrade $usv_connection_upgrade { default upgrade; '' close; }
server {
    listen __LISTEN__;
    listen [::]:__LISTEN__;
    client_max_body_size 20m;
    location = /_usv_auth {
        internal;
        proxy_pass http://__AUTH__/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }
    location / {
        auth_request /_usv_auth;
        auth_request_set $usv_user $upstream_http_x_usv_user;
        auth_request_set $usv_role $upstream_http_x_usv_role;
        # Always set here, never taken from the browser: empty = no header,
        # and Grafana shows its own login form.
        proxy_set_header X-WEBAUTH-USER $usv_user;
        proxy_set_header X-WEBAUTH-ROLE $usv_role;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $usv_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_pass http://__GRAFANA__;
    }
}
