// Example mission-file integration for grafana_bridge.
// Merge these blocks into your vessel's mission (.moos) file.
//
// The bridge's variable map is pre-aligned with the Alpha mission
// (alpha.bhv): no per-mission configuration is needed here beyond the
// InfluxDB connection. See docs/alpha-mission-integration.md.

ServerHost = localhost
ServerPort = 9000
Community  = usv-01

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200
  Run = MOOSDB          @ NewConsole = false
  // ... your existing apps (pHelmIvP, pMarinePID, pNodeReporter, ...) ...
  Run = grafana_bridge  @ NewConsole = false
}

ProcessConfig = grafana_bridge
{
  AppTick   = 10
  CommsTick = 20

  // InfluxDB connection (shore or onboard).
  // No scheme here: "//" starts a MOOS comment. Set influx_tls for https.
  influx_url    = localhost:8086
  influx_tls    = false
  influx_token  = CHANGE_ME_token
  influx_org    = usv
  influx_bucket = telemetry
  events_bucket = events
  vessel_id     = usv-01

  // Optional deployment tuning (defaults suit the simulation community).
  mission_name   = alpha       // Mission dashboard label (default: Community)
  max_rate_hz    = 5           // write ceiling for NAV_* / planchaPID (10-20 Hz raw)
  engine_rate_hz = 2           // write ceiling for ENGINE_* (iCANRec, J1939);
                               // ENGINE_<NAME>_<n> is engine instance n
  // Engine profile: taken from /etc/usv/usv.env (ENGINE_SOURCE, ENGINE_TYPE)
  // when these two are absent. ENGINE_* is passed through when MOOS is the
  // vessel's engine source (usv-725) or no source is named.
  // engine_passthrough = true
  // engine_type = mercury_diesel   // engine_type tag on every engine point
  // ignore_vars = NAV_YAW     // VESSEL ONLY: iDivisorNMEA posts NAV_YAW as
                               // the rudder angle ($AGRSA); never in simulation
  radar_cpa_alert_m = 500      // collision risk HIGH: CPA below this ...
  tcpa_alert_s   = 300         // ... within this many seconds (MEDIUM: 2x both)
  contact_ttl_s  = 10          // contact expiry without a NODE_REPORT/RADAR_TARGET
  signalk_http   = localhost:3000  // ID_ROUTE -> route name lookup
                               // (/signalk/v2 or v1/api/resources/routes/<id>);
                               // leave empty to disable
  // signalk_token = <jwt>     // only if Signal K security denies anonymous reads
  readiness_profile = vessel   // pre-departure checks: "vessel" = a check with no
                               // sensor data FAILS; "sim" = it reads N/A
                               // (simulation hosts only, never on a vessel)
  readiness_period_s = 5       // evaluation / write period
  // required_apps = pHelmIvP,pMarinePID,iWebSocket   // default: the Antler block
  // optional_apps = pMarineViewer,uMACView,uPlotViewer // reported, never a fault
  // fuel_tank_l = 200  cruise_fuel_lph = 12  cruise_speed_kn = 6   // Endurance check
  // battery_kwh = 10   cruise_power_kw = 1.5  endurance_margin = 1.5
  // checklist_items = Chart Navigation System:Verify charts are loaded and current|Weather Conditions:Current and forecast weather acceptable
  // enc_fitted = false          // no ENC chart system: the Chart/ENC row reads N/A
  // console_checklist = false   // console does not publish CHECKLIST_STATUS: row reads N/A
}
